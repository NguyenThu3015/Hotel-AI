# Local development only. Copy to .env and replace secrets before exposing any port.
POSTGRES_ADMIN_PASSWORD=hotel_admin_local_password
GATEWAY_PORT=8081
RABBITMQ_USER=hotel_local
RABBITMQ_PASSWORD=hotel_local_password
EVENT_EXCHANGE=hotel.events
REDIS_PASSWORD=redis_local_password
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-service-key

# Identity signs access tokens. Leave both locations empty for an ephemeral local key.
# For a shared environment, mount PKCS#8 private/X.509 public PEM files and use file: paths.
JWT_ISSUER=http://identity-service:8101
JWT_AUDIENCE=hotel-api
JWT_KEY_ID=identity-local-persistent-v1
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=

# External providers are intentionally disabled until the hardening slice.
MOMO_ENABLED=false
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REFUND_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund
MOMO_REFUND_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/refund/query
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:3000/payment/result
MOMO_IPN_URL=http://localhost:8081/api/v1/payments/webhooks/momo
PAYMENT_SANDBOX_ENABLED=true

# Casso Flow bank-transfer confirmation. Keep disabled until the bank account
# and Webhook V2 secret have been configured in Casso Flow.
CASSO_ENABLED=false
CASSO_WEBHOOK_SECRET=
CASSO_BANK_ID=
CASSO_ACCOUNT_NUMBER=
CASSO_ACCOUNT_NAME=
CASSO_QR_BASE_URL=https://img.vietqr.io/image
CASSO_QR_TEMPLATE=compact2
CASSO_TRANSFER_PREFIX=HOTELAI
CASSO_TIME_ZONE=Asia/Ho_Chi_Minh

# Free ngrok dev domain for Casso Webhook V2 while running the project locally.
# Get this secret from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# AES-256-GCM key for encrypted guest identity documents (Base64 of 32 random bytes).
# Replace this development value before using real guest data.
STAY_DOCUMENT_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
HOTEL_TIME_ZONE=Asia/Ho_Chi_Minh
HOTEL_CHECK_IN_HOUR=14
HOTEL_CHILD_MAX_AGE=11
HOTEL_PRIMARY_GUEST_MIN_AGE=18

EMAIL_ADAPTER_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
EMAIL_FROM=no-reply@hotelai.local
# If the primary SMTP provider is unreachable in local Docker, capture the
# message in Mailpit instead of losing OTP/transactional email.
EMAIL_FALLBACK_TO_MAILPIT=false
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_SMTP_AUTH=false
MAILPIT_SMTP_STARTTLS=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
MAIL_HEALTH_ENABLED=false

SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
# Project/demo mode: eSMS validates ZNS but does not deliver or charge a message.
# Use ZALO_PROVIDER=esms-zns-sandbox only with ZALO_SANDBOX=true.
ZALO_PROVIDER=mock
ZALO_API_URL=https://rest.esms.vn/MainService.svc/json/SendZaloMessage_V5_post/
ZALO_API_KEY=
ZALO_SECRET_KEY=
ZALO_OA_ID=4097311281936189049
ZALO_TEMPLATE_OTP_ID=205644
ZALO_TEMPLATE_DATA_KEY=otp
ZALO_SANDBOX=true

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Local resource budget. Defaults are sized for a 16 GB Windows laptop.
RESTART_POLICY=on-failure:3
JAVA_SERVICE_CPUS=0.50
JAVA_SERVICE_MEMORY_LIMIT=512m
JAVA_SERVICE_MEMORY_RESERVATION=256m
JAVA_ACTIVE_PROCESSOR_COUNT=2
JAVA_INITIAL_RAM_PERCENTAGE=10
JAVA_MAX_RAM_PERCENTAGE=50
JAVA_MAX_METASPACE_SIZE=128m
AI_SERVICE_CPUS=0.35
AI_SERVICE_MEMORY_LIMIT=256m
POSTGRES_CPUS=1.00
POSTGRES_MEMORY_LIMIT=768m
RABBITMQ_CPUS=1.00
RABBITMQ_MEMORY_LIMIT=512m
MANAGEMENT_TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.05

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
